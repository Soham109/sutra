{
  "name": "sutra",
  "private": true,
  "version": "0.1.0",
  "description": "GMP/1 — the Group Mandate Protocol. Multi-principal payment coordination engine built on Prava.",
  "workspaces": [
    "engine",
    "web",
    "cli",
    "chaos",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently -n engine,web -c magenta,cyan \"npm:dev:engine\" \"npm:dev:web\"",
    "dev:engine": "npm run start -w engine",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w engine",
    "test": "npm run test -w engine",
    "test:widget": "node --test widget/detect.test.mjs",
    "build:widget": "node widget/build-bookmarklet.mjs",
    "chaos": "npm run chaos -w chaos",
    "demo": "npm run demo -w cli",
    "nanda:check": "npm run nanda -w cli -- check",
    "nanda:scene": "node scripts/nanda-run.mjs scene",
    "nanda:test": "node scripts/nanda-run.mjs test",
    "e2e:plan": "tsx e2e/plan-flow.ts",
    "e2e:product": "tsx e2e/product-flow.ts",
    "e2e:sandbox": "tsx e2e/sandbox-smoke.ts",
    "e2e:proof": "tsx e2e/sandbox-proof.ts",
    "e2e:auth": "tsx e2e/auth-check.ts",
    "e2e:agent-mesh": "tsx e2e/agent-mesh.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "linkedom": "^0.18.11"
  },
  "engines": {
    "node": ">=22.5"
  }
}
