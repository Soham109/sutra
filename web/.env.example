# Server-side proxy destination. The browser only talks to its own origin.
ENGINE_URL=http://localhost:4100

# Server-only. Never expose this as a NEXT_PUBLIC variable.
ENGINE_API_TOKEN=dev-token

# /store: the one-click unlock for the Shopify demo store (see
# web/src/app/store/page.tsx). Optional — both default to the deployed demo
# store's own values. The storefront password is public by design; Shopify
# offers no way to remove it from a development store, so the page shows it
# on-screen as well as submitting it for you.
NEXT_PUBLIC_SHOPIFY_STORE=sutra-agzdw2mf.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PASSWORD=sutra
