# Where the GMP/1 engine lives. Next proxies /api/* here (see next.config.ts),
# so the browser only ever talks to its own origin and cookies stay first-party.
ENGINE_URL=http://localhost:4100

# Bearer token the engine requires to create groups. Must match the engine's
# ENGINE_API_TOKEN. Public by design in this hackathon build — there is no
# multi-tenant auth yet, and it grants no spending power on its own.
NEXT_PUBLIC_ENGINE_TOKEN=dev-token
