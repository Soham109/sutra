{
  "manifest_version": 3,
  "name": "sutra — split any checkout",
  "short_name": "sutra",
  "version": "1.0.0",
  "description": "Read the cart on any page and turn it into one card-network-enforced payment mandate per person.",
  "minimum_chrome_version": "111",

  "permissions": ["activeTab", "scripting", "storage"],

  "action": {
    "default_title": "Split this page with sutra",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": { "service_worker": "background.js" },

  "commands": {
    "split-this-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Mount the sutra sheet on the current page"
    }
  },

  "options_page": "popup.html"
}
