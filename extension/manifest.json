{
  "manifest_version": 3,
  "name": "sutra — decide and split together",
  "short_name": "sutra",
  "version": "1.1.0",
  "description": "Bring a product page into sutra, choose friends or a circle, and coordinate the split.",
  "minimum_chrome_version": "111",

  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://engine-production-e6fa.up.railway.app/*", "http://localhost:4100/*"],

  "action": {
    "default_title": "Split this page with sutra",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": { "service_worker": "background.js" },

  "commands": {
    "split-this-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Mount the sutra sheet on the current page"
    }
  },

  "options_page": "popup.html"
}
