# Prava
# mock    = built-in Prava simulator, zero network, full demo works offline
# sandbox = real Prava sandbox (sk_test_* key required)
PRAVA_ENV=mock
PRAVA_API_KEY=
PRAVA_BASE_URL=https://sandbox.api.prava.space

# Shopify development-store proof (optional, TEST ORDERS ONLY)
# Creates a genuine Shopify order and participant transaction records with
# test:true after every Sutra/Prava test share succeeds. Requires write_orders
# and protected-customer-data access. Never point this at a live store.
#
# Shopify stopped letting merchants create *new* custom apps in the store
# admin on 2026-01-01 — a store set up from scratch must use the Dev
# Dashboard, which issues a client ID/secret instead of a copyable token; the
# engine exchanges these itself and refreshes before Shopify's ~24h expiry.
# Set ONE of the two auth blocks below, never both. See docs/SHOPIFY_FLOW.md
# ("Configure the development store") for exact click paths.
SHOPIFY_TEST_ORDER_ENABLED=false
SHOPIFY_TEST_STORE=your-store.myshopify.com
# Public storefront domain if the product page uses a custom domain.
SHOPIFY_STOREFRONT_DOMAIN=your-store.myshopify.com
# Branch A — Dev Dashboard custom app (new setups, 2026-01-01 onward).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Branch B — legacy admin-created custom app's permanent token (only if one
# already exists on this store; new stores cannot obtain this kind anymore).
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Optional comma-separated discovery shelf; put the demo store first.
SHOPIFY_DOMAINS=

# Engine
PORT=4100
APP_BASE_URL=http://localhost:4100
NODE_ENV=development
# Railway production: mount a persistent volume at /data and use /data/gmp.db.
# Never keep production accounts on the ephemeral container filesystem.
DB_PATH=
ENGINE_API_TOKEN=dev-token
# 32-byte hex seed for the Ed25519 receipt-signing key. Generated at boot if absent (dev only).
ENGINE_SIGNING_SEED=
WEBHOOK_SECRET=dev-webhook-secret
# Set to "true" to keep the dev-auth bypass alive even when NODE_ENV=production.
# Outside of a deliberate demo deployment, leave this unset.
ALLOW_DEV_AUTH=

# Organizer agent (optional)
OPENAI_API_KEY=
# One low-cost multimodal model handles constrained intent classification and
# receipt transcription. Override this without changing application code.
OPENAI_MODEL=gpt-4.1-nano

# Web push notifications (optional). Unset means /v1/notify/subscribe reports
# itself unconfigured; nothing else fails. Generate a matching pair with the
# engine's own helper, from engine/:
#   npx tsx -e "import{generateVapidKeys}from './src/notify/push.ts';console.log(generateVapidKeys())"
# Both values are base64url.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@sutra.local
